# cmake -P cmake/strata_hip_flags_test.cmake   (no compiler, no GPU: the option parsing of cmake/strata_hip_flags.cmake)
include("${CMAKE_CURRENT_LIST_DIR}/strata_hip_flags.cmake")
function(expect_items vopd extra)
  strata_hip_flag_items("${vopd}" "${extra}" got)
  set(want "${ARGN}")
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "vopd='${vopd}' extra='${extra}': got [${got}] want [${want}]")
  endif()
endfunction()
expect_items("default" "")                      # default = no flag at all
expect_items("" "")
expect_items("DEFAULT" "   ")
expect_items("off" "" "SHELL:-mllvm -amdgpu-enable-vopd=false")
expect_items("OFF" "" "SHELL:-mllvm -amdgpu-enable-vopd=false")
expect_items("on" "" "SHELL:-mllvm -amdgpu-enable-vopd=true")
expect_items("default" " -mcumode " "SHELL:-mcumode")
expect_items("off" "-mllvm -amdgpu-sched-strategy=max-ilp" "SHELL:-mllvm -amdgpu-enable-vopd=false" "SHELL:-mllvm -amdgpu-sched-strategy=max-ilp")
# bad values must stop the configure: run the function in a child cmake and expect failure
foreach(_bad "vopd=maybe" "extra=-O3;-g" "extra=$(id)" "extra=a<b")
  string(REGEX REPLACE "=.*" "" _k "${_bad}")
  string(REGEX REPLACE "^[a-z]+=" "" _val "${_bad}")
  if(_k STREQUAL "vopd")
    set(_call "strata_hip_flag_items(\"${_val}\" \"\" x)")
  else()
    set(_call "strata_hip_flag_items(\"default\" [==[${_val}]==] x)")
  endif()
  file(WRITE "${CMAKE_CURRENT_LIST_DIR}/.hipflags_bad.cmake" "include(\"${CMAKE_CURRENT_LIST_DIR}/strata_hip_flags.cmake\")\n${_call}\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -P "${CMAKE_CURRENT_LIST_DIR}/.hipflags_bad.cmake" RESULT_VARIABLE _r OUTPUT_QUIET ERROR_QUIET)
  file(REMOVE "${CMAKE_CURRENT_LIST_DIR}/.hipflags_bad.cmake")
  if(_r EQUAL 0)
    message(FATAL_ERROR "bad value '${_bad}' was accepted")
  endif()
endforeach()
message("strata_hip_flags: ok")
