    "B": {
     "label": "deferral removed (STRATA_VERIFY_DEFER_CPU unset)",
     "env": {
      "STRATA_VERIFY_DEFER_CPU": null
     }
    },
    "C": {
     "label": "gate auto-closed (VERIFY_DEFER_AUTO=1, MIN_T=256: deferral's graphs, every CPU row on time)",
