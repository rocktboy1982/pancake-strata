   "env": {
    "HIP_VISIBLE_DEVICES": "0",
    "LD_LIBRARY_PATH": "/opt/rocm/core-10.0/lib"
   },
   "port": 8080,
   "start_est_min": 4
  },
  "pancake-q2": {
