STRATA_ENV("STRATA_QFUSE", Key, "documented exact (arch table); kept conservatively (batch-1)")
STRATA_ENV("STRATA_ROUTER_FUSE", Key, "documented exact; kept conservatively (batch-1)")
STRATA_ENV("STRATA_ROUTE_PRIOR", Key, "residency-biased routing (lossy)")
STRATA_ENV("STRATA_ROUTE_PRIOR_DEPTH", Key, "route-prior bonus graded by window position")
STRATA_ENV("STRATA_ROUTE_RESIDENT", Key, "residency-biased routing after the router (lossy)")
STRATA_ENV("STRATA_ROUTE_RESIDENT_MTP", Key, "the draft layer routed like ROUTE_RESIDENT")
STRATA_ENV("STRATA_ROUTE_RESIDENT_RANKS", Key, "rank band of ROUTE_RESIDENT")
STRATA_ENV("STRATA_ROUTE_TAIL_SKIP", Key, "skips missed tail experts (default 7 on CUDA serve; changes the output)")
