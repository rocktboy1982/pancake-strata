{"arm": "tool-snip-4000", "rep": 0, "task": "ce-dedupe-order", "kind": "code_edit", "ok": true, "valid": null, "reason": "", "elapsed": 1.056, "completion_tokens": 53, "finish": "stop", "error": null, "message": {"content": "```python\ndef dedupe(items):\n    seen = set()\n    result = []\n    for item in items:\n        if item not in seen:\n            seen.add(item)\n            result.append(item)\n    return result\n```"}}
{"arm": "tool-snip-4000", "rep": 0, "task": "ce-parse-kv", "kind": "code_edit", "ok": true, "valid": null, "reason": "", "elapsed": 1.175, "completion_tokens": 61, "finish": "stop", "error": null, "message": {"content": "```python\ndef parse_kv(text):\n    out = {}\n    for part in text.split(\";\"):\n        if not part:\n            continue\n        k, v = part.split(\"=\", 1)\n        out[k.strip()] = v.strip()\n    return out\n```"}}
{"arm": "tool-snip-4000", "rep": 0, "task": "ce-top-words", "kind": "code_edit", "ok": true, "valid": null, "reason": "", "elapsed": 1.378, "completion_tokens": 86, "finish": "stop", "error": null, "message": {"content": "```python\ndef word_counts(text):\n    counts = {}\n    for w in text.lower().split():\n        counts[w] = counts.get(w, 0) + 1\n    return counts\n\n\ndef top_words(text, n):\n    counts = word_counts(text)\n    return sorted(counts.items(), key=lambda item: (-item[1], item[0]))[:n]\n```"}}
{"arm": "tool-snip-4000", "rep": 0, "task": "ce-binary-search", "kind": "code_edit", "ok": true, "valid": null, "reason": "", "elapsed": 1.403, "completion_tokens": 94, "finish": "stop", "error": null, "message": {"content": "```python\ndef bsearch(xs, target):\n    lo, hi = 0, len(xs) - 1\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if xs[mid] == target:\n            return mid\n        if xs[mid] < target:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    return -1\n```"}}
{"arm": "tool-snip-4000", "rep": 0, "task": "ce-stack-peek", "kind": "code_edit", "ok": true, "valid": null, "reason": "", "elapsed": 1.508, "completion_tokens": 104, "finish": "stop", "error": null, "message": {"content": "```python\nclass Stack:\n    def __init__(self):\n        self._items = []\n\n    def push(self, x):\n        self._items.append(x)\n\n    def pop(self):\n        return self._items.pop()\n\n    def peek(self):\n        if not self._items:\n            raise IndexError(\"peek from an empty stack\")\n        return self._items[-1]\n\n    def __len__(self):\n        return len(self._items)\n```"}}
