{
  "machine": "owner PC: Ryzen 7 3750H, 13.9 GB RAM, GTX 1660 Ti 6 GB (sm_75), CUDA 12.8, MSVC 14.44, Windows 11",
  "tokens": "{repo} checkout, {src} build source, {build} build dir, {model} gguf, {tok} tokenizer.json, {py} python with tokenizers, {cudabin} CUDA bin, {out} the item's result folder, {ctest} ctest.exe",
  "external": ["{model}", "{tok}", "{py}", "{cudabin}", "{ctest}"],
  "built_by_build": ["strata-poly", "poly_workers_test", "poly_cpu_kernels_test", "poly_mxfp4_test", "poly_route_test",
                     "poly_gdn_cols_test", "poly_gemm_small_test", "poly_attend_split_test", "poly_expert_list_test",
                     "poly_dsv4_test", "poly_kv_q4_test", "poly_expert_parity", "poly_cpu_experts_bench",
                     "poly_draft_race_test", "head_argmax_parity", "head_gather_parity", "head_fmt_test", "q5k_head_test"],
  "items": [
    {"id": "00-build", "group": "A", "kind": "build", "est_min": 75, "ram_gb": 3, "vram_gb": 0, "timeout_min": 240,
     "title": "configure (sm_75, Shared CUDA runtime) and build strata-poly plus every target the later items run; skipped when every exe exists and is newer than the source HEAD",
     "ledger": "T-778"},
    {"id": "01-poly-cpu-tests", "group": "A", "est_min": 3, "ram_gb": 1, "vram_gb": 0, "timeout_min": 10,
     "title": "poly CPU-only unit tests (pool, cpu kernels, MXFP4), no card, no model",
     "steps": [
       {"name": "poly_workers_test", "exe": "{build}/poly_workers_test.exe", "args": []},
       {"name": "poly_cpu_kernels_test", "exe": "{build}/poly_cpu_kernels_test.exe", "args": []},
       {"name": "poly_mxfp4_test", "exe": "{build}/poly_mxfp4_test.exe", "args": []}],
     "ledger": "T-779"},
    {"id": "02-poly-gpu-synthetic", "group": "A", "est_min": 10, "ram_gb": 2, "vram_gb": 3, "timeout_min": 15,
     "title": "poly GPU kernels against host arithmetic on random data (route, gdn cols, small gemm, attention split with its sm_75 m16n8k8 path, expert list, DeepSeek V4 kernels), no model",
     "steps": [
       {"name": "poly_route_test", "exe": "{build}/poly_route_test.exe", "args": []},
       {"name": "poly_gdn_cols_test", "exe": "{build}/poly_gdn_cols_test.exe", "args": []},
       {"name": "poly_gemm_small_test", "exe": "{build}/poly_gemm_small_test.exe", "args": []},
       {"name": "poly_attend_split_test", "exe": "{build}/poly_attend_split_test.exe", "args": []},
       {"name": "poly_attend_split_time", "exe": "{build}/poly_attend_split_test.exe", "args": ["--time"]},
       {"name": "poly_expert_list_test", "exe": "{build}/poly_expert_list_test.exe", "args": []},
       {"name": "poly_expert_list_time", "exe": "{build}/poly_expert_list_test.exe", "args": ["--time"]},
       {"name": "poly_dsv4_test", "exe": "{build}/poly_dsv4_test.exe", "args": []}],
     "ledger": "T-780"},
    {"id": "03-head-parity", "group": "A", "est_min": 5, "ram_gb": 2, "vram_gb": 2, "timeout_min": 10,
     "title": "head-format kernels: fused argmax and shortlist gather parity (exit 77 = skip), head_fmt_test; synthetic, no model",
     "steps": [
       {"name": "head_argmax_parity", "exe": "{build}/head_argmax_parity.exe", "args": [], "optional": true},
       {"name": "head_gather_parity", "exe": "{build}/head_gather_parity.exe", "args": [], "optional": true},
       {"name": "head_fmt_test", "exe": "{build}/head_fmt_test.exe", "args": [], "optional": true}],
     "ledger": "T-781"},
    {"id": "04-compile-fixed-tests", "group": "B", "est_min": 6, "ram_gb": 2, "vram_gb": 3, "timeout_min": 10,
     "title": "tests that did not compile under MSVC in T-552 (poly_kv_q4_test: range-for over a braced list of pairs, kv_q4_test.cu:342; q5k_head_test: no <string>, q5k_head_test.cu:95); each runs only when its source fix has landed and the build produced the exe",
     "steps": [
       {"name": "poly_kv_q4_test", "exe": "{build}/poly_kv_q4_test.exe", "args": [], "optional": true},
       {"name": "poly_kv_q4_time", "exe": "{build}/poly_kv_q4_test.exe", "args": ["--time"], "optional": true},
       {"name": "q5k_head_test", "exe": "{build}/q5k_head_test.exe", "args": [], "optional": true}],
     "ledger": "T-782"},
    {"id": "05-poly-expert-parity", "group": "A", "est_min": 20, "ram_gb": 7, "vram_gb": 4, "timeout_min": 45,
     "title": "poly_expert_parity on the 11 GB model: GPU and CPU expert products against a double-precision reference for every tensor type in the file",
     "steps": [{"name": "poly_expert_parity", "exe": "{build}/poly_expert_parity.exe", "args": ["{model}"]}],
     "needs": ["{model}"], "ledger": "T-783"},
    {"id": "06-poly-cpu-experts-bench", "group": "A", "est_min": 15, "ram_gb": 7, "vram_gb": 0, "timeout_min": 30,
     "title": "CPU expert read speed against what the RAM gives (no card): 8 and 4 threads, then the --multi path with --check",
     "steps": [
       {"name": "cpu_experts_t8", "exe": "{build}/poly_cpu_experts_bench.exe", "args": ["{model}", "--threads", "8", "--stream-gib", "1"]},
       {"name": "cpu_experts_t4", "exe": "{build}/poly_cpu_experts_bench.exe", "args": ["{model}", "--threads", "4", "--stream-gib", "1"]},
       {"name": "cpu_experts_multi_check", "exe": "{build}/poly_cpu_experts_bench.exe", "args": ["{model}", "--threads", "8", "--multi", "--check", "--skip-stream"]}],
     "needs": ["{model}"], "ledger": "T-784"},
    {"id": "07-poly-draft-race", "group": "A", "est_min": 25, "ram_gb": 8, "vram_gb": 5, "timeout_min": 60,
     "title": "poly_draft_race_test: a read with the draft block repeated 3 times must match bit for bit (exit 3 = SKIP)",
     "steps": [{"name": "poly_draft_race_test", "exe": "{build}/poly_draft_race_test.exe", "args": ["{model}", "3"]}],
     "needs": ["{model}"], "ledger": "T-785"},
    {"id": "08-spec159-poly-flags", "group": "B", "est_min": 80, "ram_gb": 8, "vram_gb": 5, "timeout_min": 150,
     "title": "spec 159: strata-poly flag arms on the 1660 Ti through bench_win_ab.py (needs the new runner tools/pancake/bench_win_ab.py)",
     "steps": [{"name": "spec159", "exe": "{py}",
                "args": ["{repo}/tools/pancake/bench_win_ab.py", "{repo}/bench/specs/159-gtx1660ti-poly-flags.json", "--out", "{out}/arms"],
                "env": {"STRATA_POLY_EXE": "{build}/strata-poly.exe", "STRATA_MODEL": "{model}", "STRATA_TOKENIZER": "{tok}", "CUDA_BIN": "{cudabin}"}}],
     "needs": ["{model}", "{tok}", "{py}", "{repo}/bench/specs/159-gtx1660ti-poly-flags.json"], "ledger": "T-786"},
    {"id": "09-spec160-poly-kernels", "group": "B", "est_min": 35, "ram_gb": 8, "vram_gb": 5, "timeout_min": 80,
     "title": "spec 160: strata-poly kernel switches (default-on switches turned off) through bench_win_ab.py",
     "steps": [{"name": "spec160", "exe": "{py}",
                "args": ["{repo}/tools/pancake/bench_win_ab.py", "{repo}/bench/specs/160-gtx1660ti-poly-kernels.json", "--out", "{out}/arms"],
                "env": {"STRATA_POLY_EXE": "{build}/strata-poly.exe", "STRATA_MODEL": "{model}", "STRATA_TOKENIZER": "{tok}", "CUDA_BIN": "{cudabin}"}}],
     "needs": ["{model}", "{tok}", "{py}", "{repo}/bench/specs/160-gtx1660ti-poly-kernels.json"], "ledger": "T-787"},
    {"id": "10-ctest-cpu-gpu", "group": "A", "only_with": "WithCtest", "est_min": 30, "ram_gb": 3, "vram_gb": 4, "timeout_min": 60,
     "title": "ctest -L cpu and -L gpu of the sm_75 build; OFF unless -WithCtest (the agent that built the sm_75 tree runs the same ctest); needs a build configured with -DSTRATA_BUILD_TESTS=ON",
     "steps": [
       {"name": "ctest_cpu", "exe": "{ctest}", "args": ["--test-dir", "{build}", "-L", "cpu", "--output-on-failure", "--timeout", "120"], "optional": true},
       {"name": "ctest_gpu", "exe": "{ctest}", "args": ["--test-dir", "{build}", "-L", "gpu", "--output-on-failure", "--timeout", "300"], "optional": true}],
     "ledger": "none"}
  ]
}
