{"arm": "plain#a", "rep": 0, "task": "ce-dedupe-order", "kind": "code_edit", "ok": true, "valid": null, "reason": "", "elapsed": 1.391, "completion_tokens": 53, "finish": "stop", "error": null, "message": {"content": "```python\ndef dedupe(items):\n    seen = set()\n    result = []\n    for item in items:\n        if item not in seen:\n            seen.add(item)\n            result.append(item)\n    return result\n```"}}
{"arm": "plain#a", "rep": 0, "task": "ce-parse-kv", "kind": "code_edit", "ok": true, "valid": null, "reason": "", "elapsed": 1.663, "completion_tokens": 61, "finish": "stop", "error": null, "message": {"content": "```python\ndef parse_kv(text):\n    out = {}\n    for part in text.split(\";\"):\n        if not part:\n            continue\n        k, v = part.split(\"=\", 1)\n        out[k.strip()] = v.strip()\n    return out\n```"}}
{"arm": "plain#a", "rep": 0, "task": "ce-top-words", "kind": "code_edit", "ok": true, "valid": null, "reason": "", "elapsed": 4.682, "completion_tokens": 93, "finish": "stop", "error": null, "message": {"content": "```python\ndef word_counts(text):\n    counts = {}\n    for w in text.lower().split():\n        counts[w] = counts.get(w, 0) + 1\n    return counts\n\ndef top_words(text, n):\n    counts = word_counts(text)\n    sorted_items = sorted(counts.items(), key=lambda x: (-x[1], x[0]))\n    return sorted_items[:n]\n```"}}
{"arm": "plain#a", "rep": 0, "task": "ce-binary-search", "kind": "code_edit", "ok": true, "valid": null, "reason": "", "elapsed": 2.181, "completion_tokens": 109, "finish": "stop", "error": null, "message": {"content": "```python\ndef bsearch(xs, target):\n    lo, hi = 0, len(xs) - 1\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if xs[mid] == target:\n            return mid\n        if xs[mid] < target:\n            lo = mid + 1\n        else:\n            hi = mid\n    if lo == hi and xs[lo] == target:\n        return lo\n    return -1\n```"}}
{"arm": "plain#a", "rep": 0, "task": "ce-stack-peek", "kind": "code_edit", "ok": true, "valid": null, "reason": "", "elapsed": 1.678, "completion_tokens": 104, "finish": "stop", "error": null, "message": {"content": "```python\nclass Stack:\n    def __init__(self):\n        self._items = []\n\n    def push(self, x):\n        self._items.append(x)\n\n    def pop(self):\n        return self._items.pop()\n\n    def peek(self):\n        if not self._items:\n            raise IndexError(\"peek from an empty stack\")\n        return self._items[-1]\n\n    def __len__(self):\n        return len(self._items)\n```"}}
